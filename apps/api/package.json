{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST principal con NestJS",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.0",
    "@platform/auth": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/encryption": "workspace:*",
    "@platform/url-safety": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/payment-providers": "workspace:*",
    "@platform/redis": "workspace:*",
    "@platform/model-providers": "workspace:*",
    "@platform/agent-runtime": "workspace:*",
    "@platform/webhook-sdk": "workspace:*",
    "@platform/channel-adapters": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.33.0",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@anatine/esbuild-decorators": "^0.2.10",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@platform/config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.9.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
