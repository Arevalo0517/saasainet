# ============================================================
# Ejemplo de variables de entorno. Copia a .env.local y completa.
# NUNCA commitees .env.local ni ningún archivo con secretos reales.
# ============================================================

# Entorno
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WIDGET_URL=http://localhost:3002

# ----- Supabase (Postgres en la nube) -----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# ----- Redis (Upstash REST) -----
UPSTASH_REDIS_REST_URL=https://YOUR-REGION.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ----- Autenticación -----
AUTH_SECRET=REEMPLAZA_CON_BASE64URL_DE_64_BYTES
AUTH_COOKIE_NAME=platform_session
AUTH_SESSION_DAYS=7

# ----- OpenAI (Fase 4) -----
OPENAI_API_KEY=sk-proj-...
OPENAI_ORG_ID=

# ----- Pagos (Fase 3) -----
# Modo: 'mock' para desarrollo, 'stripe' en staging/prod
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ----- Defaults de producto -----
COMMISSION_DEFAULT_PERCENT=20
COMMISSION_HOLD_DAYS=15
TOPUP_DEFAULT_EXPIRATION_DAYS=90
DEFAULT_LANGUAGE=es
DEFAULT_CURRENCY=mxn
WHITE_LABEL_ENABLED=false

# ----- Observabilidad -----
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
