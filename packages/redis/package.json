  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/node": "^20.14.10",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
