{
  "name": "@platform/redis",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente Redis con adaptador Upstash REST y MockProvider para dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
